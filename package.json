{
    "name": "competitor-change-tracker",
    "version": "1.0.0",
    "type": "module",
    "description": "Track competitors' public pricing, terms/privacy, careers, changelog and product pages; get only meaningful changes with plain-English summaries and severity (Fairquery).",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "cheerio": "^1.2.0",
        "playwright": "1.64.1"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "ajv": "^8.20.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.12"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "test": "vitest run"
    },
    "author": "Fairquery",
    "license": "MIT",
    "overrides": {
        "basic-ftp": "^6.2.3"
    }
}
